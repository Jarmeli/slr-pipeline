# ─── PostgreSQL (Azure) ───────────────────────────────────────
PGHOST=your-server.postgres.database.azure.com
PGPORT=5432
PGUSER=your_admin_user
PGPASSWORD=your_password
PGDATABASE=your_database
PGSSL=true

# ─── LM Studio ───────────────────────────────────────────────
# Local LM Studio instance, accessible from Docker via host.docker.internal
LM_STUDIO_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=local-model   # matches the model name shown in LM Studio

# ─── Data paths ───────────────────────────────────────────────
# Mounted volume path for model artifacts (inside containers)
ARTIFACTS_DIR=/artifacts
# Local data directory for CSV inputs (used by MEL trainer)
DATA_DIR=/data

# ─── Agent ports ──────────────────────────────────────────────
PREPPER_PORT=7000
DIO_PORT=7001
MEL_PORT=7002
SIMO_PORT=7003

# ─── ChromaDB (SIMO RAG) ─────────────────────────────────────
CHROMA_PERSIST_DIR=/artifacts/chroma
