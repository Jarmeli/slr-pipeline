# ─── PostgreSQL (Azure) ───────────────────────────────────────
PGHOST=your-server.postgres.database.azure.com
PGPORT=5432
PGUSER=your_admin_user@your-server-name   # Azure Single Server requires @servername suffix
PGPASSWORD=your_password
PGDATABASE=your_database
PGSSL=true

# ─── LM Studio ───────────────────────────────────────────────
# Option A: Local machine (default) — Docker containers reach it via host.docker.internal
#LM_STUDIO_URL=http://host.docker.internal:1234/v1
#LM_STUDIO_MODEL=local-model

# Option B: Azure VM — Ollama headless inference (recommended when local compute is limited)
# Run scripts/azure-vm-create.sh to provision a Standard_D2s_v3 VM (canadacentral).
# vm-lmstudio-init.sh installs Ollama + phi3:mini automatically.
# Port 11434 is opened only for your IP via NSG.
LM_STUDIO_URL=http://<azure-vm-public-ip>:11434/v1
LM_STUDIO_MODEL=phi3:mini

# Test connectivity:
#   curl http://<azure-vm-public-ip>:11434/v1/models

# ─── Data paths ───────────────────────────────────────────────
# Mounted volume path for model artifacts (inside containers)
ARTIFACTS_DIR=/artifacts
# Local data directory for CSV inputs (used by MEL trainer)
DATA_DIR=/data

# ─── Agent ports ──────────────────────────────────────────────
PREPPER_PORT=7004   # 7000 is taken by macOS AirPlay Receiver; change if needed
DIO_PORT=7001
MEL_PORT=7002
SIMO_PORT=7003

# ─── ChromaDB (SIMO RAG) ─────────────────────────────────────
CHROMA_PERSIST_DIR=/chroma
